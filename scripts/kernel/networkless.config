# COLDIRON OS — networkless kernel config fragment
#
# Applied on top of Debian trixie's amd64 kernel config (linux-config-6.12)
# by scripts/build-kernel.sh. Goal: a kernel with NO networking hardware
# support and NO loadable modules — the strongest honest "networkless"
# position that still runs a systemd live system.
#
# Why not CONFIG_NET=n entirely?
#   The networking core (CONFIG_NET) also provides netlink, which
#   systemd-udevd REQUIRES for device events, plus AF_UNIX local sockets
#   used by X11/dbus. Disabling it would break udev and the desktop.
#   Loopback AF_INET stays for the same reason (Java/Sparrow and other
#   userspace use local TCP/UDP sockets). The attack surface that matters
#   for exfiltration — a driver that can talk to real hardware — is gone:
#   there is no driver for ANY network-capable device, and with
#   CONFIG_MODULES=n there is no module that could ever be inserted.
#
# Monolithic build: CONFIG_MODULES=n — every driver is built in or not at
# all; /lib/modules does not exist in the image; modprobe has nothing it
# could ever load. This closes the "root loads a driver" attack outright.

# ---- networking: loopback only -------------------------------------------
CONFIG_NET=y                      # required: netlink (udev) + AF_UNIX
CONFIG_NET_LOOPBACK_DRIVER=y      # lo interface (userspace local sockets)
CONFIG_INET=y                     # loopback TCP/UDP only (no NIC can exist)
CONFIG_NETDEVICES=n               # ALL network device drivers (NIC, tun,
                                  # veth, dummy, wireguard, usb-net, wimax…)
CONFIG_WIRELESS=n                 # cfg80211/mac80211 (also kills rfkill net)
CONFIG_CFG80211=n
CONFIG_MAC80211=n
CONFIG_BT=n                       # bluetooth
CONFIG_NFC=n                      # near-field
CONFIG_CAN=n                      # controller area network
CONFIG_NETFILTER=n                # no packet filter at all — no packets
CONFIG_IPV6=n                     # IPv6 compiled out (was sysctl-disabled)
CONFIG_PACKET=n                   # no raw packet sockets
CONFIG_NET_SCHED=n                # no QoS/queueing
CONFIG_NET_9P=n                   # no 9p network fs
CONFIG_ATM=n
CONFIG_BRIDGE=n
CONFIG_VLAN_8021Q=n
CONFIG_LLC=n
CONFIG_X25=n
CONFIG_LAPB=n
CONFIG_NET_IPIP=n
CONFIG_NET_IPGRE=n
CONFIG_NET_IPVTI=n
CONFIG_IP_MULTICAST=n
CONFIG_INET_DIAG=n                # ss/netlink diagnostics not needed
CONFIG_SYN_COOKIES=n

# ---- peripheral attack surface that is also networking-capable -----------
CONFIG_FIREWIRE=n                 # FireWire (DMA) — was module-blacklisted
CONFIG_THUNDERBOLT=n              # Thunderbolt (DMA)
CONFIG_MEDIA_SUPPORT=n            # no cameras/video capture (webcam attack)

# ---- no loadable modules at all -------------------------------------------
CONFIG_MODULES=n

# ---- runtime attack-surface reduction -------------------------------------
CONFIG_KEXEC=n                    # kexec syscall compiled out (was sysctl)
CONFIG_HIBERNATION=n              # no hibernation image attack surface
CONFIG_SOUND=n                    # no audio stack (not needed; was present)
CONFIG_DEBUG_INFO=n               # no DWARF debug (smaller, faster build)

# ---- runtime verification --------------------------------------------------
CONFIG_IKCONFIG=y                 # /proc/config.gz — coldiron-check and users
CONFIG_IKCONFIG_PROC=y            # can verify the networkless config at runtime

# ---- local version: distinguish from stock Debian kernels ----------------
# (LOCALVERSION=-coldiron is passed on the make command line by
#  build-kernel.sh — do NOT set CONFIG_LOCALVERSION here or it doubles up)
