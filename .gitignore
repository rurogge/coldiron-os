# build artifacts
dist/
*.iso
*.img

# live-build working directories
chroot/
.build/
cache/
binary/

# logs
*.log

# your personal signing keyrings (out-of-band trust anchors — never published)
keys/*.gpg

# live-build generated config (regenerated by `lb config`)
config/apt/
config/archives/
config/binary
config/bootstrap
config/chroot
config/common
config/source
config/tasks/
config/includes.binary/
config/includes.installer/
config/package-lists/*.list
auto/

# live-build generated hooks (stock hooks copied in by `lb config`;
# only config/hooks/normal/0100-coldiron-setup.chroot is maintained here)
config/hooks/**/*.hook.chroot

# live-build root artifacts (stage markers / package lists)
chroot.*
binary.modified_timestamps

# generated / third-party binaries (fetched + verified by scripts/fetch-binaries.sh)
config/includes.chroot/opt/sparrow/

# local trusted keyrings (created by build-root.sh step 2 — machine-local trust state)
keys/*.gpg
keys/*.gpg~

# misc
.cache/
*.swp

# fetched third-party binaries (downloaded + verified by scripts/fetch-binaries.sh)
config/includes.chroot/opt/bitcoin/

# lb build root artifacts
live-image-amd64.*
