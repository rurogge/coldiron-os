# COLDIRON OS — AppArmor profile for the encrypted seed backup.
abi <abi/4.0>,
include <tunables/global>

profile /usr/local/bin/coldiron-digital-backup {
  include <abstractions/base>
  include <abstractions/bash>

  deny network,

  /usr/local/bin/coldiron-lib r,
  /usr/local/bin/coldiron-vault px,
  /{usr/,}bin/age ux,
  /{usr/,}bin/mountpoint ux,
  /{usr/,}bin/wipe ux,
  /{usr/,}bin/sha256sum ux,
  /{usr/,}bin/mktemp ux,
  /{usr/,}bin/date ux,
  /{usr/,}bin/mkdir ux,
  /mnt/vault/** rw,
  /usr/local/bin/coldiron-* r,   # bash reads the script under the profile
  /dev/tty rw,                   # interactive menu I/O
  /dev/ttyS0 rw,                 # serial console (E2E / remote)
}
