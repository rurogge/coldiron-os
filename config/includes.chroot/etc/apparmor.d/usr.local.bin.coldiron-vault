# COLDIRON OS — AppArmor profile for the vault unlocker.
abi <abi/4.0>,
include <tunables/global>

profile /usr/local/bin/coldiron-vault {
  include <abstractions/base>
  include <abstractions/bash>

  deny network,

  /{usr/,}bin/bash mr,   # interpreter mmap under px transitions

  /usr/local/bin/coldiron-lib r,
  /{usr/,}sbin/cryptsetup ux,
  /{usr/,}bin/mount ux,
  /{usr/,}bin/umount ux,
  /{usr/,}bin/blkid ux,
  /{usr/,}bin/lsblk ux,
  /{usr/,}bin/findmnt ux,
  /{usr/,}bin/mkdir ux,
  /dev/ r,
  /dev/** r,
  /dev/mapper/control rw,
  /usr/local/bin/coldiron-* r,   # bash reads the script under the profile
  /dev/tty rw,                   # interactive menu I/O
  /dev/ttyS0 rw,                 # serial console (E2E / remote)
  /{usr/,}bin/cat ux,
  /{usr/,}bin/cut ux,
  /{usr/,}bin/grep ux,
  /{usr/,}bin/head ux,
  /{usr/,}bin/tail ux,
  /{usr/,}bin/chmod ux,
  /{usr/,}bin/rm ux,
  /{usr/,}bin/mountpoint ux,
}
