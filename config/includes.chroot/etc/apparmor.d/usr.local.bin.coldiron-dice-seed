# COLDIRON OS — AppArmor profile for the dice-seed generator.
# Confines the bash process running the script: no network, only the
# expected helpers may be executed. (See keys/boot/README.md for the
# security model — the networkless kernel makes the network deny
# redundant; this is defense in depth.)
abi <abi/4.0>,
include <tunables/global>

profile /usr/local/bin/coldiron-dice-seed {
  include <abstractions/base>
  include <abstractions/bash>

  deny network,

  /usr/local/bin/coldiron-lib r,
  /{usr/,}bin/python3 ux,
  /{usr/,}bin/python3.* ux,
  /usr/local/bin/coldiron-digital-backup px,
  /dev/urandom r,
  /usr/local/bin/coldiron-* r,   # bash reads the script under the profile
  /dev/tty rw,                   # interactive menu I/O
  /dev/ttyS0 rw,                 # serial console (E2E / remote)
}
