#!/bin/bash
#
# coldiron-check — verify the appliance's security posture.
#
# Runs the checks behind the product acceptance criteria and prints a
# PASS/FAIL line per check. Exit code 0 only when every check passes.
#
# Usage:
#   coldiron-check                full posture check (menu option 8)
#   coldiron-check --boot-verify  only the boot-file signature check
#
set -uo pipefail

. "${COLDIRON_LIB:-/usr/local/bin/coldiron-lib}"

PASS=0; FAIL=0
ok()   { PASS=$((PASS+1)); echo "  ✔ PASS: ${1}"; }
bad()  { FAIL=$((FAIL+1)); echo "  ✘ FAIL: ${1}"; }

header "SYSTEM SECURITY CHECK"

# ------------------------------------------------------------------ networkless
if [ -f /proc/config.gz ]; then
  if zcat /proc/config.gz 2>/dev/null | grep -q '^CONFIG_NETDEVICES=y'; then
    bad "kernel still has network device drivers (CONFIG_NETDEVICES=y)"
  else
    ok "kernel has no network device drivers (CONFIG_NETDEVICES=n)"
  fi
  if zcat /proc/config.gz 2>/dev/null | grep -q '^CONFIG_MODULES=y'; then
    bad "kernel still allows loadable modules (CONFIG_MODULES=y)"
  else
    ok "kernel is monolithic — no loadable modules (CONFIG_MODULES=n)"
  fi
else
  note "kernel config not exposed (/proc/config.gz missing) — skipping"
fi

NETIFS="$(ls /sys/class/net 2>/dev/null | grep -v '^lo$' || true)"
if [ -z "${NETIFS}" ]; then
  ok "only loopback interface exists"
else
  bad "network interfaces present: ${NETIFS}"
fi

MODS="$(ls /lib/modules 2>/dev/null | wc -l)"
if [ "${MODS}" = "0" ] || [ ! -d /lib/modules ]; then
  ok "no kernel module directories (/lib/modules empty or absent)"
else
  bad "/lib/modules contains ${MODS} kernel(s)"
fi

# ------------------------------------------------------------------ confinement
if [ -f /sys/module/apparmor/parameters/enabled ] \
   && [ "$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null)" = "Y" ]; then
  ok "AppArmor is enabled"
  PROFILES="$(aa-status 2>/dev/null | sed -n 's/^\([0-9]*\) profiles are in enforce mode.*/\1/p')"
  if [ -n "${PROFILES}" ] && [ "${PROFILES}" -ge 4 ]; then
    ok "AppArmor enforcing ${PROFILES} profiles"
  else
    bad "AppArmor profiles not loaded (enforce count: ${PROFILES:-0})"
  fi
else
  bad "AppArmor is not enabled"
fi

# ------------------------------------------------------------------ packet policy
if [ -d /proc/net/netfilter ] || nft list ruleset >/dev/null 2>&1; then
  if nft list ruleset 2>/dev/null | grep -q 'policy drop'; then
    ok "packet policy: default-deny present"
  else
    bad "packet policy: no default-deny ruleset"
  fi
else
  ok "no packet filtering subsystem in kernel — nothing to filter (networkless)"
fi

# ------------------------------------------------------------------ boot integrity
boot_verify() {
  local okc=0 f
  for f in /boot/vmlinuz-*; do
    [ -f "${f}" ] || continue
    if [ ! -f "${f}.sig" ]; then echo "  ✘ FAIL: no signature for ${f}"; return 1; fi
    gpgv --quiet --keyring /usr/share/coldiron/boot-key.pub "${f}.sig" "${f}" 2>/dev/null \
      || { echo "  ✘ FAIL: signature invalid for ${f}"; return 1; }
    okc=$((okc+1))
  done
  for f in /boot/initrd.img-*; do
    [ -f "${f}" ] || continue
    if [ ! -f "${f}.sig" ]; then echo "  ✘ FAIL: no signature for ${f}"; return 1; fi
    gpgv --quiet --keyring /usr/share/coldiron/boot-key.pub "${f}.sig" "${f}" 2>/dev/null \
      || { echo "  ✘ FAIL: signature invalid for ${f}"; return 1; }
    okc=$((okc+1))
  done
  [ "${okc}" -ge 2 ] && echo "  ✔ PASS: ${okc} boot files verified" || echo "  ✘ FAIL: too few boot files"
  [ "${okc}" -ge 2 ]
}

if [ "${1:-}" = "--boot-verify" ]; then
  boot_verify && exit 0 || exit 1
fi
if [ -f /usr/share/coldiron/boot-key.pub ]; then
  boot_verify || FAIL=$((FAIL+1))
else
  bad "boot public key missing (/usr/share/coldiron/boot-key.pub)"
fi

# ------------------------------------------------------------------ summary
echo
if [ "${FAIL}" -eq 0 ]; then
  echo "  ✅ ALL CHECKS PASSED — the appliance matches its security posture."
else
  echo "  ⚠  ${FAIL} CHECK(S) FAILED — do not trust this system with funds."
fi
echo
echo "  RESULT: ${PASS} passed, ${FAIL} failed"
[ "${FAIL}" -eq 0 ]
