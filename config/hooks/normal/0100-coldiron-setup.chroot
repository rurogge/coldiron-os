#!/bin/sh
#
# 0100-coldiron-setup.chroot — COLDIRON OS in-image configuration.
# Runs inside the build chroot.
#
set -e

echo "==> COLDIRON: system setup"

# --- helper scripts must be executable
chmod 0755 /usr/local/bin/coldiron-* 2>/dev/null || true

# --- loopback-only networking
cat > /etc/network/interfaces <<'EOF'
# COLDIRON OS: loopback only. No interfaces are brought up.
auto lo
iface lo inet loopback
EOF

# --- disable services that must not exist in an offline appliance
for svc in NetworkManager wpa_supplicant ModemManager bluetooth cups avahi-daemon; do
  systemctl disable "${svc}" 2>/dev/null || true
done

# --- desktop: autologin on tty1; auto-start openbox there.
# Without autologin the appliance is unusable: root is locked in the image
# (root:* in shadow) and live-config's default autologin logs in as "user"
# (created at boot, password "live") — but the appliance scripts need root
# (cryptsetup). The drop-in is named zzz-* so it sorts AFTER live-config's
# autologin drop-in and wins the systemd ExecStart merge → autologin as
# root, straight into the desktop. Physical possession of the USB is the
# real authentication for this offline, RAM-only appliance.
mkdir -p /etc/systemd/system/getty@tty1.service.d
cat > /etc/systemd/system/getty@tty1.service.d/zzz-coldiron-autologin.conf <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin root --noclear %I $TERM
EOF

# Root password: documented default (offline appliance, no remote
# attack surface; allows login on other ttys / serial for troubleshooting).
# Fixed crypt hash (SHA-512, fixed salt) — chpasswd's default yescrypt uses
# a RANDOM salt per run, which broke the reproducible byte-diff.
echo 'root:$6$c0ld1r0n$bdmhyPfhjcMYOhvC7SmJJzumijwsC0KZXz5sw2dWI9EBIWpv4.2ljSu6onY1SmaVZBEAx5u1roqU.OTI4hyTg.' | chpasswd -e

mkdir -p /root/.config/openbox

cat > /root/.xinitrc <<'EOF'
#!/bin/sh
exec openbox-session
EOF
chmod 0755 /root/.xinitrc

cat > /root/.config/openbox/autostart <<'EOF'
# COLDIRON desktop: launcher menu in a terminal
xterm -T "COLDIRON OS" -e /usr/local/bin/coldiron-menu &
# screen blank + lock after 5 min idle (shoulder-surf protection)
xscreensaver -no-splash &
EOF

# xscreensaver: blank + lock after 5 minutes idle
cat > /root/.xscreensaver <<'EOF'
timeout:	5
lock:		True
lockTimeout:	0
fade:		True
EOF

cat >> /root/.bash_profile <<'EOF'
# COLDIRON OS: auto-start X on the first console
if [ -z "${DISPLAY:-}" ] && [ "${XDG_VTNR:-}" = "1" ]; then
  exec startx
fi
EOF

# --- no shell history (RAM-only anyway; belt and suspenders)
cat > /etc/profile.d/coldiron.sh <<'EOF'
export HISTFILE=/dev/null
export HISTSIZE=0
EOF

# --- fallback desktop for live-config's "user" session (if it ever wins
# the autologin merge): user is created at first boot by live-config;
# pre-creating the home makes useradd reuse it. Written here, after the
# root autostart exists, so the copy succeeds.
mkdir -p /home/user/.config/openbox
cat > /home/user/.xinitrc <<'EOF'
#!/bin/sh
exec openbox-session
EOF
chmod 0755 /home/user/.xinitrc
cp /root/.config/openbox/autostart /home/user/.config/openbox/autostart 2>/dev/null || true

# --- desktop launchers for the appliance actions
mkdir -p /usr/share/applications
cat > /usr/share/applications/coldiron-vault.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Unlock Vault
Comment=Unlock and mount the encrypted vault USB
Exec=/usr/local/bin/coldiron-vault
Terminal=true
Categories=Security;System;
EOF

cat > /usr/share/applications/coldiron-digital-backup.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Create Encrypted Seed Backup
Comment=Optional encrypted seed backup (secondary recovery)
Exec=/usr/local/bin/coldiron-digital-backup
Terminal=true
Categories=Security;System;
EOF

cat > /usr/share/applications/coldiron-restore.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Restore Encrypted Seed Backup
Comment=Decrypt a seed backup
Exec=/usr/local/bin/coldiron-restore
Terminal=true
Categories=Security;System;
EOF

cat > /usr/share/applications/coldiron-shutdown.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Shutdown Securely
Comment=Unmount vault and power off
Exec=/usr/local/bin/coldiron-shutdown
Terminal=true
Categories=System;Shutdown;
EOF

exit 0
