#!/bin/sh
#
# 9600-sign-boot.chroot — sign /boot kernel + initramfs with the COLDIRON
# boot key so coldiron-check can verify them at runtime, and REMOVE the
# temporary private key before the rootfs is packed (it must never ship).
#
# The keypair is a BUILD COMPONENT, not a trust anchor — see
# keys/boot/README.md. The authenticity chain is the release signature
# (SHA256SUMS.asc); this check is corruption/tamper belt+braces.
#
set -e

KEYDIR=/usr/share/coldiron
if [ -f "${KEYDIR}/boot.sec" ] && command -v gpg >/dev/null 2>&1; then
  GNUPGHOME="$(mktemp -d /tmp/bootsign.XXXXXX)"
  gpg --batch --quiet --homedir "${GNUPGHOME}" --import "${KEYDIR}/boot.sec"
  # Sign into /boot/signatures/ — NOT /boot/ — because live-build's grub
  # generator globs chroot/boot/vmlinuz-* and would emit menu entries for
  # the .sig files (boot entries pointing at signatures).
  SIGDIR=/boot/signatures
  mkdir -p "${SIGDIR}"
  for f in /boot/vmlinuz-* /boot/initrd.img-*; do
    [ -f "${f}" ] || continue
    case "${f}" in *.sig) continue ;; esac
    # --faked-system-time pins the signature creation time (the sig packet
    # embeds it) so the .sig is byte-identical across builders. Use the fixed
    # value, NOT SOURCE_DATE_EPOCH: live-build always sets SDE (1786492800 =
    # 2026-08-12T00:00:00Z) which is BEFORE the boot key's creation
    # (1786528838) and gpg refuses with "Time conflict". 1786579200 =
    # 2026-08-13T00:00:00Z, after the key.
    gpg --batch --quiet --homedir "${GNUPGHOME}" \
        --faked-system-time 1786579200 \
        --detach-sign --output "${SIGDIR}/$(basename "${f}").sig" "${f}"
  done
  # binary keyring for gpgv (coldiron-check) — gpgv cannot read armored keys.
  # Export to a plain pubring instead of --import into a keybox: the kbx
  # header embeds the CURRENT TIME (created/last-modified fields), which
  # broke the reproducible byte-diff. A --export stream has no file
  # timestamps and is byte-identical across builds for the same key.
  gpg --batch --quiet --homedir "${GNUPGHOME}" \
      --export > "${KEYDIR}/boot-keyring.gpg"
  rm -rf "${GNUPGHOME}"
  rm -f "${KEYDIR}/boot.sec"
  echo "==> COLDIRON: boot files signed; temporary private key removed"
fi

exit 0
