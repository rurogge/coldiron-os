# Exclude apt cache artifacts from the squashfs at pack time.
#
# The 9900-clean-apt-cache.chroot hook already removes these, but apt
# operations that run after it in the chroot (chroot_hacks, the binary
# stage package removal) recreate pkgcache.bin, whose binary content
# embeds per-build state and differs between builders. Excluding the
# files here makes the squashfs byte-identical regardless of when apt
# last touched them. Patterns are matched with -wildcards by live-build
# (mksquashfs -ef).
var/cache/apt/pkgcache.bin
var/cache/apt/srcpkgcache.bin
var/cache/apt/archives/*
var/lib/apt/lists/*
